<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_320"
    android:background="@drawable/rfid_card_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/dp_20">

    <FrameLayout
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_104">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lav_reader_connect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading" />

        <ImageView
            android:id="@+id/iv_reader_connect_result"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:layout_gravity="center"
            android:contentDescription="连接结果"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_reader_connect_phase"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32"
        android:gravity="center"
        android:text="正在连接"
        android:textColor="@color/rfid_text"
        android:textSize="@dimen/sp_16" />

    <TextView
        android:id="@+id/tv_reader_connect_detail"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_80"
        android:gravity="center"
        android:maxLines="4"
        android:textColor="@color/rfid_text_muted"
        android:textSize="@dimen/sp_12" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reader_connect_cancel"
            style="@style/RfidTextButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:text="取消" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reader_connect_close"
            style="@style/RfidTextButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:text="关闭"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
