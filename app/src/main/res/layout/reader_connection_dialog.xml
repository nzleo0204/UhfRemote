<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rfid_card_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dialog_padding"
    android:paddingVertical="12dp">

    <!-- 动画/图标区域 -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <!-- Loading 动画 -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lav_reader_connect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading" />

        <!-- 结果图标（成功/失败） -->
        <ImageView
            android:id="@+id/iv_reader_connect_result"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 标题（居中、普通字重） -->
    <TextView
        android:id="@+id/tv_reader_connect_phase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="正在连接"
        android:textColor="@color/rfid_text"
        android:textSize="18sp" />

    <!-- 详情描述（居中、灰色、普通字重） -->
    <TextView
        android:id="@+id/tv_reader_connect_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="36dp"
        android:gravity="center"
        android:maxLines="2"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/rfid_text_muted"
        android:textSize="14sp" />

    <!-- 按钮区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <!-- 取消按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reader_connect_cancel"
            style="@style/RfidTextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:minWidth="110dp"
            android:text="取消"
            android:textSize="15sp" />

        <!-- 关闭按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reader_connect_close"
            style="@style/RfidPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:minWidth="110dp"
            android:text="关闭"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
