<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_single_read_result"
    style="@style/RfidCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dp_16"
    android:layout_marginTop="@dimen/dp_16"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32"
        android:layout_marginBottom="@dimen/dp_10">

        <TextView
            android:id="@+id/tv_single_data_label"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="EPC"
            android:textColor="@color/rfid_text"
            android:textSize="@dimen/sp_16" />

        <TextView
            android:id="@+id/btn_single_fill_read_data_mask"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_8"
            android:text="@string/single_fill_mask"
            android:textColor="@color/rfid_danger"
            android:textSize="@dimen/sp_13" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/group_single_read_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_single_read_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rfid_field_bg"
            android:fontFamily="monospace"
            android:gravity="start|center_vertical"
            android:minHeight="@dimen/dp_44"
            android:padding="@dimen/dp_12"
            android:textColor="@color/rfid_primary"
            android:clickable="false"
            android:focusable="false"
            android:longClickable="false"
            android:textIsSelectable="false"
            android:textSize="@dimen/sp_15" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/group_single_chip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="@dimen/dp_80"
            android:layout_height="wrap_content"
            android:text="芯片型号"
            android:textColor="@color/rfid_text_muted"
            android:textSize="@dimen/sp_14" />

        <TextView
            android:id="@+id/tv_single_chip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="-"
            android:textColor="@color/rfid_text"
            android:textSize="@dimen/sp_14" />
    </LinearLayout>

    <include layout="@layout/rfid_single_info_rssi" />

    <TextView
        android:id="@+id/tv_single_epc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/rfid_field_bg"
        android:clickable="false"
        android:focusable="false"
        android:fontFamily="monospace"
        android:longClickable="false"
        android:minHeight="@dimen/dp_40"
        android:padding="@dimen/dp_10"
        android:textColor="@color/rfid_text_secondary"
        android:textIsSelectable="false"
        android:textSize="@dimen/sp_14" />
</LinearLayout>
