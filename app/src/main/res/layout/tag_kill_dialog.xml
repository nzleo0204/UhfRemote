<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dialog_padding"
    android:paddingVertical="20dp">

    <!-- 严重警告提示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rfid_chip_red_bg"
        android:padding="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/rfid_warning_outline_bg"
            app:tint="@color/white"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="严重警告：标签销毁操作"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="此操作将永久禁用标签，使其无法再被读取。操作不可逆，请谨慎执行！"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <!-- 访问密码 -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="访问密码（8 位 HEX）"
        app:hintTextColor="@color/rfid_text_muted"
        app:boxStrokeColor="@color/rfid_danger"
        app:helperText="空密码请输入 00000000"
        app:helperTextTextColor="@color/rfid_text_muted"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_tag_kill_access_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:textSize="16sp"
            android:textColor="@color/rfid_text"
            android:fontFamily="monospace"
            android:maxLength="8" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 销毁密码 -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="销毁密码（8 位 HEX）"
        app:hintTextColor="@color/rfid_text_muted"
        app:boxStrokeColor="@color/rfid_danger"
        app:helperText="空密码请输入 00000000"
        app:helperTextTextColor="@color/rfid_text_muted"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_tag_kill_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:textSize="16sp"
            android:textColor="@color/rfid_text"
            android:fontFamily="monospace"
            android:maxLength="8" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
