<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rfid_page_bg"
    android:fillViewport="true"
    tools:context=".ui.fragment.home.ReaderConfigFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_72"
            android:background="@color/rfid_nav_bg"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_20"
            android:paddingVertical="@dimen/dp_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_40"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="RFID 读写器"
                    android:textColor="@color/rfid_text"
                    android:textSize="@dimen/sp_18" />

                <TextView
                    android:id="@+id/tv_config_status"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_30"
                    android:background="@drawable/rfid_chip_gray_bg"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:text="● 未连接"
                    android:textColor="@color/rfid_text"
                    android:textSize="@dimen/sp_12" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_config_device_info"
                    style="@style/RfidTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_40"
                    android:minWidth="0dp"
                    android:text="设备"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_config_connection_target"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_16"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_12"
                android:visibility="gone"
                tools:text="UHF Reader · 00:11:22:33:44:55" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_config_hardware"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_16"
            android:background="@drawable/rfid_card_bg"
            android:orientation="vertical"
            android:padding="@dimen/dp_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="功率设置"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="发射功率"
                    android:textColor="@color/rfid_text"
                    android:textSize="@dimen/sp_16" />

                <TextView
                    android:id="@+id/tv_config_power_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rfid_primary_soft"
                    android:textSize="@dimen/sp_16"
                    tools:text="26 dBm" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_config_power"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_36"
                android:max="33"
                android:progress="26"
                android:progressTint="@color/rfid_primary_soft"
                android:thumbTint="@color/rfid_primary_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 dBm"
                    android:textColor="@color/rfid_text_muted"
                    android:textSize="@dimen/sp_12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="33 dBm"
                    android:textColor="@color/rfid_text_muted"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_config_protocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:background="@drawable/rfid_card_bg"
            android:orientation="vertical"
            android:padding="@dimen/dp_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="协议与模式"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_12" />

            <include layout="@layout/rfid_config_row_protocol" />
            <include layout="@layout/rfid_config_row_work_mode" />
            <include layout="@layout/rfid_config_row_session" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_config_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_16"
            android:background="@drawable/rfid_card_bg"
            android:orientation="vertical"
            android:padding="@dimen/dp_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="传输方式"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_12" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tg_config_transport"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:orientation="horizontal"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_config_ble"
                    style="@style/RfidSegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="蓝牙" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_config_wifi"
                    style="@style/RfidSegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Wi-Fi" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/ll_config_ble_actions"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_config_ble_device"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="未选择设备"
                    android:textColor="@color/rfid_text"
                    android:textSize="@dimen/sp_16" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_config_ble_scan"
                    style="@style/RfidTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="搜索设备" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_config_wifi_actions"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:gravity="center_vertical"
                android:visibility="gone">
                <EditText
                    android:id="@+id/et_config_wifi_ip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="读写器 IP 地址"
                    android:inputType="textUri"
                    android:textColor="@color/rfid_text"
                    android:textSize="@dimen/sp_16" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_config_wifi_connect"
                    style="@style/RfidTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连接" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_config_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:background="@drawable/rfid_card_bg"
            android:orientation="vertical"
            android:padding="@dimen/dp_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="速率设置"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_12" />

            <include layout="@layout/rfid_config_row_blf" />
            <include layout="@layout/rfid_config_row_q" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
