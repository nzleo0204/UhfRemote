<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_56"
    android:background="@color/rfid_panel_bg"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/dp_12"
    android:paddingVertical="@dimen/dp_8">

    <TextView
        android:id="@+id/tv_inventory_index"
        android:layout_width="@dimen/dp_40"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/rfid_text_muted"
        android:textSize="@dimen/sp_12" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_inventory_epc_label"
                android:layout_width="@dimen/dp_36"
                android:layout_height="wrap_content"
                android:text="@string/inventory_item_epc"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_11" />

            <TextView
                android:id="@+id/tv_inventory_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/rfid_primary_soft"
                android:textSize="@dimen/sp_13" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_inventory_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_inventory_data_label"
                android:layout_width="@dimen/dp_36"
                android:layout_height="wrap_content"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_11" />

            <TextView
                android:id="@+id/tv_inventory_data"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/rfid_text_secondary"
                android:textSize="@dimen/sp_13" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_inventory_chip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_inventory_chip_label"
                android:layout_width="@dimen/dp_36"
                android:layout_height="wrap_content"
                android:text="@string/inventory_item_chip"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_11" />

            <TextView
                android:id="@+id/tv_inventory_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/rfid_text"
                android:textSize="@dimen/sp_13" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_inventory_count"
        android:layout_width="@dimen/dp_52"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/rfid_text"
        android:textSize="@dimen/sp_13" />

    <TextView
        android:id="@+id/tv_inventory_rssi"
        android:layout_width="@dimen/dp_52"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/rfid_success"
        android:textSize="@dimen/sp_11" />
</LinearLayout>
