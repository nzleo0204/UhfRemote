<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rfid_page_bg"
    android:orientation="vertical">
    <LinearLayout android:id="@+id/ll_title_bar" android:layout_width="match_parent" android:layout_height="@dimen/dp_56" android:background="@color/rfid_nav_bg" android:gravity="center_vertical" android:paddingHorizontal="@dimen/dp_16">
        <ImageView android:id="@+id/iv_title_back" android:layout_width="@dimen/dp_40" android:layout_height="@dimen/dp_40" android:padding="@dimen/dp_10" android:src="@drawable/rfid_back_ic" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/stock_query_title" android:textColor="@color/rfid_text" android:textSize="@dimen/sp_18" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/dp_64" android:gravity="center_vertical" android:paddingHorizontal="@dimen/dp_16">
        <EditText android:layout_width="0dp" android:layout_height="@dimen/dp_44" android:layout_weight="1" android:background="@drawable/rfid_field_bg" android:hint="标签编码或 SKU" android:paddingHorizontal="@dimen/dp_12" android:textColor="@color/rfid_text" />
        <com.google.android.material.button.MaterialButton android:id="@+id/tv_stock_search" style="@style/RfidPrimaryButton" android:layout_width="wrap_content" android:layout_height="@dimen/dp_44" android:layout_marginStart="@dimen/dp_8" android:text="查询" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="暂无库存数据" android:textColor="@color/rfid_text_muted" android:textSize="@dimen/sp_14" />
</LinearLayout>
