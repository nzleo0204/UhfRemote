<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/rfid_panel_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:maxHeight="400dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 标题（RFID设备，蓝色） -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="RFID设备"
            android:textColor="@color/rfid_primary"
            android:textSize="17sp" />

        <!-- 关闭按钮（红色） -->
        <ImageButton
            android:id="@+id/btn_ble_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭"
            android:padding="8dp"
            android:src="@drawable/rfid_close_ic"
            app:tint="@color/rfid_danger" />
    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rfid_line"
        android:layout_marginVertical="8dp" />

    <!-- 扫描状态提示 + 重新扫描按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 扫描状态（绿色） -->
        <TextView
            android:id="@+id/tv_ble_scan_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="正在扫描蓝牙设备..."
            android:textColor="@color/rfid_success"
            android:textSize="13sp" />

        <!-- 重新扫描按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ble_rescan"
            style="@style/RfidTextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="重新扫描"
            android:textSize="13sp"
            android:paddingHorizontal="10dp"
            android:minWidth="0dp" />
    </LinearLayout>

    <!-- 设备列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_ble_devices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false" />

    <!-- 空状态提示 -->
    <TextView
        android:id="@+id/tv_ble_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="未发现设备"
        android:textColor="@color/rfid_text_muted"
        android:textSize="14sp"
        android:visibility="gone"
        android:drawableTop="@drawable/rfid_bluetooth_ic"
        android:drawableTint="@color/rfid_line"
        android:drawablePadding="12dp" />
</LinearLayout>
