<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_8">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="锁定区域" android:textColor="@color/rfid_text_muted" />
    <Spinner android:id="@+id/sp_tag_lock_bank" android:layout_width="match_parent" android:layout_height="@dimen/dp_48" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="锁定策略" android:textColor="@color/rfid_text_muted" />
    <Spinner android:id="@+id/sp_tag_lock_policy" android:layout_width="match_parent" android:layout_height="@dimen/dp_48" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="访问密码（8 位 HEX）">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_tag_lock_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
