<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <!-- 第一行：起始地址 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/dialog_row_min_height"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_inventory_addr"
            android:textColor="@color/rfid_text"
            android:textSize="@dimen/dialog_label_text_size" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.hjq.custom.widget.view.RegexEditText
                android:id="@+id/et_inventory_range_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dialog_input_bg"
                android:gravity="center"
                android:inputType="number"
                android:minHeight="@dimen/dialog_row_min_height"
                android:paddingStart="@dimen/dp_10"
                android:paddingTop="@dimen/dp_8"
                android:paddingEnd="50dp"
                android:paddingBottom="@dimen/dp_8"
                android:singleLine="true"
                android:textAlignment="center"
                android:textColor="@color/rfid_text"
                android:textSize="@dimen/dialog_value_text_size"
                app:regexType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_10"
                android:text="@string/config_inventory_unit"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/dialog_value_text_size" />
        </RelativeLayout>
    </LinearLayout>

    <!-- 第二行：读取长度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_row_spacing"
        android:gravity="center_vertical"
        android:minHeight="@dimen/dialog_row_min_height"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_inventory_len"
            android:textColor="@color/rfid_text"
            android:textSize="@dimen/dialog_label_text_size" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.hjq.custom.widget.view.RegexEditText
                android:id="@+id/et_inventory_range_len"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dialog_input_bg"
                android:gravity="center"
                android:inputType="number"
                android:minHeight="@dimen/dialog_row_min_height"
                android:paddingStart="@dimen/dp_10"
                android:paddingTop="@dimen/dp_8"
                android:paddingEnd="50dp"
                android:paddingBottom="@dimen/dp_8"
                android:singleLine="true"
                android:textAlignment="center"
                android:textColor="@color/rfid_text"
                android:textSize="@dimen/dialog_value_text_size"
                app:regexType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_10"
                android:text="@string/config_inventory_unit"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/dialog_value_text_size" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
