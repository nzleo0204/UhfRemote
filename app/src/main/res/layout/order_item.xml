<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/RfidCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_order_no"
            style="@style/RfidRowLabel"
            android:textSize="@dimen/sp_15" />

        <TextView
            android:id="@+id/tv_order_status"
            style="@style/RfidValueChip"
            android:layout_height="@dimen/dp_24"
            android:paddingHorizontal="@dimen/dp_8"
            android:textSize="@dimen/sp_11" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_order_product_image"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_64"
            android:background="@drawable/rfid_thumb_bg"
            android:contentDescription="@null"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_order_product"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/rfid_text"
                android:textSize="@dimen/sp_15" />

            <TextView
                android:id="@+id/tv_order_qty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tv_order_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:textColor="@color/rfid_primary_soft"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_order_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_order_progress_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="生产进度"
            android:textColor="@color/rfid_text_muted"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:id="@+id/tv_order_progress_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rfid_primary_soft"
            android:textSize="@dimen/sp_12" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_order_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_6"
        android:max="100"
        android:progressDrawable="@drawable/rfid_progress_drawable" />

    <TextView
        android:id="@+id/tv_order_process_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="生产过程记录"
        android:textColor="@color/rfid_text_muted"
        android:textSize="@dimen/sp_11" />

    <HorizontalScrollView
        android:id="@+id/hsv_order_process"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_6"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_order_process_images"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
