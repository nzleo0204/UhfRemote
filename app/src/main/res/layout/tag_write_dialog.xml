<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dialog_padding"
        android:paddingVertical="20dp">

        <!-- 存储区选择 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="存储区"
            android:textColor="@color/rfid_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:paddingBottom="8dp" />

        <Spinner
            android:id="@+id/sp_tag_bank"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp" />

        <!-- 起始地址 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_tag_length"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="起始地址（Word）"
            app:hintTextColor="@color/rfid_text_muted"
            app:boxStrokeColor="@color/rfid_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_tag_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="16sp"
                android:textColor="@color/rfid_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 用户子区（国标协议） -->
        <LinearLayout
            android:id="@+id/group_tag_gb_sub_bank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="用户子区"
                android:textColor="@color/rfid_text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="8dp" />

            <Spinner
                android:id="@+id/sp_tag_gb_sub_bank"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <!-- 块长度 / 重试次数 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="块长度 / 重试次数"
            app:hintTextColor="@color/rfid_text_muted"
            app:boxStrokeColor="@color/rfid_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_tag_length"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="16sp"
                android:textColor="@color/rfid_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- HEX 数据 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="HEX 数据"
            app:hintTextColor="@color/rfid_text_muted"
            app:boxStrokeColor="@color/rfid_primary"
            app:helperText="偶数长度的十六进制字符串"
            app:helperTextTextColor="@color/rfid_text_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_tag_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:textSize="16sp"
                android:textColor="@color/rfid_text"
                android:fontFamily="monospace" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 访问密码 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="访问密码（8 位 HEX）"
            app:hintTextColor="@color/rfid_text_muted"
            app:boxStrokeColor="@color/rfid_primary"
            app:helperText="空密码请输入 00000000"
            app:helperTextTextColor="@color/rfid_text_muted"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_tag_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:textSize="16sp"
                android:textColor="@color/rfid_text"
                android:fontFamily="monospace"
                android:maxLength="8" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
