<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/RfidCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_shipment_order_no"
            style="@style/RfidRowLabel"
            android:textSize="@dimen/sp_15" />

        <TextView
            android:id="@+id/tv_shipment_status"
            style="@style/RfidValueChip"
            android:layout_height="@dimen/dp_24"
            android:paddingHorizontal="@dimen/dp_8"
            android:textSize="@dimen/sp_11" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="标签型号"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tv_shipment_product"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rfid_text_secondary"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="发货数量"
                android:textColor="@color/rfid_text_muted"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tv_shipment_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rfid_text_secondary"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dp_10"
        android:background="@color/rfid_line" />

    <LinearLayout
        android:id="@+id/ll_shipment_courier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:contentDescription="@null"
                android:src="@drawable/rfid_shipment_ic"
                app:tint="@color/rfid_primary_soft" />

            <TextView
                android:id="@+id/tv_shipment_carrier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_weight="1"
                android:textColor="@color/rfid_primary_soft"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tv_shipment_carrier_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rfid_warning"
                android:textSize="@dimen/sp_11" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_shipment_tracking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:textColor="@color/rfid_text_secondary"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:id="@+id/btn_shipment_copy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/rfid_outline_button_bg"
            android:gravity="center"
            android:text="复制运单号"
            android:textColor="@color/rfid_primary_soft"
            android:textSize="@dimen/sp_13" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_shipment_batch_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="分批发货明细"
        android:textColor="@color/rfid_text_muted"
        android:textSize="@dimen/sp_12" />

    <LinearLayout
        android:id="@+id/ll_shipment_batches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/ll_shipment_timeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:orientation="vertical" />
</LinearLayout>
