<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/RfidCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_shipment_order_no"
            style="@style/RfidRowLabel"
            android:textSize="@dimen/sp_15" />

        <TextView
            android:id="@+id/tv_shipment_status"
            style="@style/RfidValueChip" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_shipment_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:textColor="@color/rfid_text_secondary"
        android:textSize="@dimen/sp_13" />

    <TextView
        android:id="@+id/tv_shipment_tracking"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_42"
        android:layout_marginTop="@dimen/dp_10"
        android:background="@drawable/rfid_field_bg"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/dp_12"
        android:textColor="@color/rfid_text"
        android:textSize="@dimen/sp_14" />

    <LinearLayout
        android:id="@+id/ll_shipment_timeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:orientation="vertical" />
</LinearLayout>
