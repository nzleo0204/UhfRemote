<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_home_root"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rfid_nav_bg"
    android:orientation="horizontal"
    tools:context=".ui.activity.HomeActivity">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_home_navigation"
        android:layout_width="@dimen/dp_120"
        android:layout_height="match_parent"
        android:background="@color/rfid_nav_bg"
        android:elevation="@dimen/dp_10"
        android:paddingVertical="@dimen/dp_14"
        tools:itemCount="5"
        tools:listitem="@layout/home_navigation_item" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/rfid_line" />

    <com.hjq.custom.widget.layout.NoScrollViewPager
        android:id="@+id/vp_home_pager"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
